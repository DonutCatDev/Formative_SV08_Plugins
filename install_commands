git clone https://github.com/DonutCatDev/Formative_SV08_Plugins.git
cd Formative_SV08_Plugins && ./install-plugins.sh

# Noninteractive alternatives:
# ./install-plugins.sh --list
# ./install-plugins.sh lcd_vsd_browser
# ./install-plugins.sh filament_tracker
# ./install-plugins.sh network_status
# ./install-plugins.sh lcd_updates
# ./install-plugins.sh --all

# Force install/repair of all available plugins (preserves conflicting files):
# ./install-plugins.sh --all -r
# ./install-plugins.sh -r lcd_updates

# Uninstall all installer-owned plugin links, or one plugin:
# ./install-plugins.sh --all -u
# ./install-plugins.sh -u lcd_vsd_browser
# ./install-plugins.sh -u filament_tracker
# ./install-plugins.sh -u network_status
# ./install-plugins.sh -u lcd_updates

# Remove legacy installations without prompts (currently Network Status only):
# This deletes the recognized legacy checkout and its legacy module link.
# ./install-plugins.sh --all --rl
# ./install-plugins.sh --rl network_status

# Long action aliases: --uninstall, --repair, --remove-legacy.
# Actions are mutually exclusive. Add --no-restart to defer service restarts.
# Plugin configuration is activated through installer-owned entrypoints under
# ~/printer_data/config/custom_plugins/*.cfg.
